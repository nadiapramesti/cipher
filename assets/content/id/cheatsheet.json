[
  {
    "group": "Termux",
    "items": [
      {
        "cmd": "pkg update && pkg upgrade",
        "desc": "Perbarui semua paket"
      },
      {
        "cmd": "termux-setup-storage",
        "desc": "Izinkan akses folder HP"
      },
      {
        "cmd": "pkg install python git curl nano",
        "desc": "Pasang alat dasar"
      },
      {
        "cmd": "pkg install nmap",
        "desc": "Pasang Nmap"
      },
      {
        "cmd": "pkg list-installed",
        "desc": "Lihat paket terpasang"
      }
    ]
  },
  {
    "group": "Linux",
    "items": [
      {
        "cmd": "pwd",
        "desc": "Folder saat ini"
      },
      {
        "cmd": "ls -la",
        "desc": "Isi folder + file tersembunyi + izin"
      },
      {
        "cmd": "cd ..",
        "desc": "Naik satu folder"
      },
      {
        "cmd": "cat file.txt",
        "desc": "Baca isi file"
      },
      {
        "cmd": "grep -i error log.txt",
        "desc": "Cari kata (abaikan huruf besar)"
      },
      {
        "cmd": "chmod 600 rahasia.txt",
        "desc": "Cuma pemilik yang bisa baca/tulis"
      },
      {
        "cmd": "whoami",
        "desc": "Akun yang sedang dipakai"
      },
      {
        "cmd": "sudo apt update && sudo apt full-upgrade",
        "desc": "Update Kali/Debian"
      }
    ]
  },
  {
    "group": "Jaringan",
    "items": [
      {
        "cmd": "ip a",
        "desc": "Lihat alamat IP perangkat"
      },
      {
        "cmd": "ping -c 4 8.8.8.8",
        "desc": "Cek koneksi ke sebuah alamat"
      },
      {
        "cmd": "nslookup google.com",
        "desc": "Tanya DNS: IP sebuah domain"
      },
      {
        "cmd": "curl -I https://contoh.com",
        "desc": "Lihat header HTTP sebuah situs"
      },
      {
        "cmd": "traceroute google.com",
        "desc": "Lihat jalur paket ke tujuan"
      }
    ]
  },
  {
    "group": "Nmap (jaringan sendiri)",
    "items": [
      {
        "cmd": "nmap 192.168.1.1",
        "desc": "Scan port umum di router"
      },
      {
        "cmd": "nmap -sn 192.168.1.0/24",
        "desc": "Cari perangkat yang nyala"
      },
      {
        "cmd": "nmap -sV 192.168.1.1",
        "desc": "Deteksi versi layanan"
      },
      {
        "cmd": "nmap -p 22,80,443 192.168.1.1",
        "desc": "Scan port tertentu"
      },
      {
        "cmd": "nmap scanme.nmap.org",
        "desc": "Target latihan resmi Nmap"
      }
    ]
  },
  {
    "group": "Filter Wireshark",
    "items": [
      {
        "cmd": "http",
        "desc": "Cuma lalu lintas HTTP"
      },
      {
        "cmd": "dns",
        "desc": "Cuma kueri DNS"
      },
      {
        "cmd": "tls",
        "desc": "Cuma lalu lintas terenkripsi TLS"
      },
      {
        "cmd": "ip.addr == 192.168.1.1",
        "desc": "Lalu lintas dari/ke satu IP"
      },
      {
        "cmd": "tcp.port == 443",
        "desc": "Lalu lintas port 443"
      }
    ]
  },
  {
    "group": "Hash & encoding",
    "items": [
      {
        "cmd": "sha256sum file.apk",
        "desc": "Hash SHA-256 sebuah file"
      },
      {
        "cmd": "echo -n 'teks' | base64",
        "desc": "Encode Base64"
      },
      {
        "cmd": "echo 'Q0lQSEVS' | base64 -d",
        "desc": "Decode Base64"
      },
      {
        "cmd": "echo -n 'teks' | xxd -p",
        "desc": "Teks ke hex"
      }
    ]
  },
  {
    "group": "Windows",
    "items": [
      {
        "cmd": "wsl --install -d kali-linux",
        "desc": "Pasang Kali di WSL (PowerShell admin)"
      },
      {
        "cmd": "ipconfig /all",
        "desc": "Lihat detail jaringan"
      },
      {
        "cmd": "netstat -ano",
        "desc": "Koneksi aktif + nomor proses"
      },
      {
        "cmd": "certutil -hashfile file.exe SHA256",
        "desc": "Hash file di Windows"
      }
    ]
  }
]